generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AssetStatus {
  Available
  In_Use
  Maintenance
  @@map("asset_status")
}

enum ActionType {
  Check_Out
  Check_In
  Maintenance_Start
  Maintenance_End
  @@map("action_type")
}

enum UserRole {
  Admin
  Operator
  Viewer
  @@map("user_role")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  assets      Asset[]
  @@map("categories")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(150)
  email     String   @unique @db.VarChar(255)
  role      UserRole @default(Operator)
  password  String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  traceLogs TraceLog[]
  @@index([email])
  @@map("users")
}

model Asset {
  id              String      @id @default(uuid()) @db.Uuid
  serialNumber    String      @unique @map("serial_number") @db.VarChar(100)
  name            String      @db.VarChar(200)
  description     String?     @db.VarChar(500)
  status          AssetStatus @default(Available)
  currentLocation String?     @map("current_location") @db.VarChar(255)
  categoryId      String      @map("category_id") @db.Uuid
  lastMovementAt  DateTime?   @map("last_movement_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  category        Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  traceLogs       TraceLog[]
  @@index([serialNumber])
  @@index([name])
  @@index([status])
  @@index([categoryId])
  @@map("assets")
}

model TraceLog {
  id               String     @id @default(uuid()) @db.Uuid
  assetId          String     @map("asset_id") @db.Uuid
  userId           String     @map("user_id") @db.Uuid
  actionType       ActionType @map("action_type")
  timestamp        DateTime   @default(now())
  notes            String?    @db.VarChar(1000)
  locationSnapshot String?    @map("location_snapshot") @db.VarChar(255)
  asset            Asset      @relation(fields: [assetId], references: [id], onDelete: Restrict)
  user             User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([assetId])
  @@index([userId])
  @@index([timestamp(sort: Desc)])
  @@index([assetId, timestamp(sort: Desc)])
  @@map("trace_logs")
}
